{
  "manifest_version": 3,
  "name": "Gemini Quiz Solver",
  "version": "2.0",
  "description": "Select text and hit Alt+S to get answers via Gemini API.",
  "permissions": [
    "storage", 
    "contextMenus", 
    "scripting", 
    "activeTab"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "send-quiz-question": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Send selected question to Gemini"
    }
  }
}