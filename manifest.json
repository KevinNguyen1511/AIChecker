{
  "manifest_version": 3,
  "name": "Universal Quiz AI Bridge",
  "version": "3.0",
  "description": "Instant live-streaming quiz assistant powered by Gemini API.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "send-quiz-question": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Send selected question to Gemini AI"
    }
  }
}