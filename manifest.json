{
  "manifest_version": 3,
  "name": "Gemini Quiz Solver",
  "version": "1.0",
  "permissions": ["storage", "contextMenus", "scripting", "activeTab"],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"] }]
}